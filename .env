# ─── ResumeIQ v2 — Environment Variables ───
SECRET_KEY=change-me-to-a-random-string
DEBUG=true
DATABASE_URL=sqlite:///resumeiq_v2.db

# LLM Provider (optional — system works without these using rule-based fallback)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AI...

# Embedding model (default: uses sentence-transformers locally, free)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# FAISS index persistence path
FAISS_INDEX_PATH=./data/faiss_index

# Upload settings
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./data/uploads